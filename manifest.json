{
  "manifest_version": 3,
  "name": "Orkut Digger",
  "version": "1.0.0",
  "description": "Exporte comunidades históricas do Orkut preservadas no Internet Archive para CSV.",
  "action": {"default_popup": "popup.html"},
  "permissions": ["activeTab", "downloads", "storage"],
  "host_permissions": ["https://web.archive.org/*"],
  "browser_specific_settings": {
    "gecko": { "id": "orkut-digger@douglasferreira.me", "strict_min_version": "121.0" }
  }
}
